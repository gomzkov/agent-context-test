{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gomzkov/agent-context-test/main/schema/context-tests.v1.schema.json",
  "title": "Agent Context Test contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assertions"],
  "properties": {
    "version": {
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["codex", "claude"]
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/available"
          },
          {
            "$ref": "#/$defs/skill"
          },
          {
            "$ref": "#/$defs/unavailableSource"
          },
          {
            "$ref": "#/$defs/unavailableText"
          }
        ]
      }
    }
  },
  "$defs": {
    "available": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect", "contains"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "const": "available"
        },
        "contains": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "const": "skill"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unavailableSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "const": "unavailable"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unavailableText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expect", "contains"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "const": "unavailable"
        },
        "contains": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
